<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plays P5R's side of the link without the game: real field collision, a fixed "Joker", scripted keys.
       Run against Minecraft (fabric dev client or the real instance) to check collision and coordinates. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\p5rpc.personacraft\Log.cs" />
    <Compile Include="..\..\p5rpc.personacraft\Link\*.cs" />
    <Compile Include="..\..\p5rpc.personacraft\World\Coords.cs" />
    <Compile Include="..\..\p5rpc.personacraft\World\CollisionExporter.cs" />
    <ProjectReference Include="..\..\PersonaCraft.Core\PersonaCraft.Core.csproj" />
    <PackageReference Include="Reloaded.Mod.Interfaces" Version="2.4.0" />
  </ItemGroup>
</Project>
